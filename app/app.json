{
  "expo": {
    "name": "Eagles 7\u20130",
    "slug": "eagles-seven-zero",
    "scheme": "eagles70",
    "version": "5.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.eagles70.game",
      "supportsTablet": true
    },
    "android": {
      "package": "com.eagles70.game"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/eagles-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/eagles-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#071e19"
        }
      ]
    ],
    "icon": "./assets/brand/eagles-mark.png"
  }
}
